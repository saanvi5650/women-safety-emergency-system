# ---------- Required ----------
# Local MongoDB or a free MongoDB Atlas cluster connection string
MONGO_URI=mongodb://127.0.0.1:27017/sheshield
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---------- App ----------
PORT=5000
# Public URL of this server. It is put in the tracking links sent to your contacts,
# so it must be reachable from their phones (e.g. your Render URL or an ngrok tunnel).
APP_URL=http://localhost:5000
# Used for alert timestamps and day/night safety scoring
TZ=Asia/Kolkata
# Seconds between escalation layers when nobody responds
ESCALATION_INTERVAL_SECONDS=60
# Only needed if the frontend is hosted on a different origin (comma separated)
# CORS_ORIGIN=http://127.0.0.1:5500

# ---------- Email alerts (Gmail example) ----------
# 1. Turn on 2-Step Verification for the Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM="SheShield Alerts <you@gmail.com>"

# ---------- SMS alerts (pick one: twilio | fast2sms) ----------
SMS_PROVIDER=

# Twilio (works worldwide; trial accounts can only text verified numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +15005550006
TWILIO_FROM=

# Fast2SMS (India only; "Quick SMS" route works without DLT registration)
FAST2SMS_API_KEY=
